{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Beautify Alert",
  "id": "miteshdhangar76-beautifyalert-app",
  "backend": true,
  "executable": "gpx_beautifyalert",
  "info": {
    "keywords": ["alerting", "email", "notifications", "html", "templates", "smtp"],
    "description": "Send Grafana alerts as designed HTML emails: your own templates per alert, live preview, test sends and a delivery log.",
    "author": {
      "name": "Mitesh Dhangar"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Documentation",
        "url": "https://github.com/MiteshDhangar/beautify-alert#readme"
      },
      {
        "name": "Report an issue",
        "url": "https://github.com/MiteshDhangar/beautify-alert/issues"
      }
    ],
    "screenshots": [
      {
        "name": "Template editor",
        "path": "img/screenshots/templates.png"
      },
      {
        "name": "Email",
        "path": "img/screenshots/email.png"
      },
      {
        "name": "Delivery log",
        "path": "img/screenshots/delivery-log.png"
      },
      {
        "name": "Setup",
        "path": "img/screenshots/setup.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Templates",
      "path": "/a/%PLUGIN_ID%/templates",
      "role": "Editor",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Delivery log",
      "path": "/a/%PLUGIN_ID%/history",
      "role": "Editor",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Setup",
      "path": "/a/%PLUGIN_ID%/setup",
      "role": "Admin",
      "addToNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
